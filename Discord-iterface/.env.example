
# Host del server Quarkus a cui il bot inoltra i messaggi
SERVER_HOST="localhost"

# Porta del server Quarkus (borys-ai-agent, default 9090)
SERVER_PORT=9090

# Modalità produzione: se "true", rimuove i tool di sviluppo
PRODUCTION=false

############### Bot Discord ###############

# Token del bot Discord (ottenuto da https://discord.com/developers/applications)
BORYS_TOKEN="il-tuo-token-discord"



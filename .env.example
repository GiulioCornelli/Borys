
############### Broker MQTT EMQX ###############

# Host dell'admin panel di EMQX (HTTP, non MQTT)
EMQX_HOST="http://localhost:18083"

# Credenziali admin per accedere al pannello EMQX
EMQX_ADMIN_USER="admin"
EMQX_ADMIN_PASSWORD="la-tua-password-admin"

# Utenti MQTT autorizzati sul broker (formato JSON array)
# Ogni utente ha username e password, usati da backend e dispositivi
EMQX_MQTT_USERS=[{"username":"borys_backend","password":"password-backend"},{"username":"clima_provider","password":"password-provider"}]
